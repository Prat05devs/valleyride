# The Express API. On a real phone use your Mac's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Razorpay public key is fetched from the API at payment time. Secrets belong only on the backend.
# Owner-supplied contact numbers (E.164). Buttons that need them stay disabled until set.
EXPO_PUBLIC_DESK_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=

# Public website, for links out of the app
EXPO_PUBLIC_WEB_URL=http://localhost:3000

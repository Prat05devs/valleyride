{
  "expo": {
    "name": "Valley Ride",
    "slug": "valley-ride",
    "scheme": "valleyride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.valleyride.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.valleyride.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Valley Ride uses the camera to photograph your driving licence and ID for verification.",
          "photosPermission": "Valley Ride lets you upload a photo of your driving licence or ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#000000"
        }
      ],
      "./plugins/with-scene-lifecycle",
      "./plugins/with-test-cleartext"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}

{
  "expo": {
    "name": "Valley Ride",
    "slug": "valley-ride",
    "scheme": "valleyride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "9Q56J23Z23",
      "bundleIdentifier": "in.valleyride.app",
      "buildNumber": "1",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp", "credpay", "mobikwik", "in.fampay.app", "bhim", "amazonpay", "navi", "kiwi", "payzapp", "jupiter", "omnicard", "icici", "popclubapp", "sbiyono", "myjio", "slice-upi", "bobupi", "shriramone", "indusmobile", "whatsapp", "kotakbank"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.valleyride.app",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://valleyride.in"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Valley Ride uses the camera to photograph your driving licence and ID for verification.",
          "photosPermission": "Valley Ride lets you upload a photo of your driving licence or ID.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#000000"
        }
      ],
      "./plugins/with-scene-lifecycle",
      "./plugins/with-test-cleartext",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": "https://valleyride.in"
      },
      "eas": {
        "projectId": "605395ba-9ea7-489d-8690-79cba6821f17"
      }
    },
    "owner": "wtsolutions5"
  }
}

{
  "name": "@valleyride/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"tsx watch --env-file-if-exists=.env src/server.ts\" \"tsx watch --env-file-if-exists=.env src/worker.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@sentry/node": "^9.47.2",
    "@valleyride/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.14.0",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.8",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@valleyride/eslint-config": "workspace:*",
    "@valleyride/tsconfig": "workspace:*",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}

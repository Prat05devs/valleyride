NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://valley:valley@localhost:5432/valleyride
# Production defaults to verified TLS. false is for Postgres on the private Docker network only.
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8090
# Configure payments here only. Website/app fetch the public key from /api/v1/payments/config.
# These development placeholders enable local mock payments; production never mocks payments.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
WHATSAPP_API_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=
# Local mail goes to Mailpit (http://localhost:8025); production uses the SES SMTP endpoint
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Valley Ride <no-reply@valleyride.in>
OPS_EMAIL=
# Phase 4: keep false until legal and CA sign-off
CAPITAL_PORTAL_ENABLED=false
AWS_REGION=ap-south-1
S3_BUCKET_PRIVATE=valleyride-kyc-prod
SENTRY_DSN=
TZ_DISPLAY=Asia/Kolkata
# Production: .valleyride.in so the website middleware sees the login cookie
COOKIE_DOMAIN=

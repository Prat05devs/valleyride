# Browser and server calls go to the Express API.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Razorpay public key is fetched from the API at payment time. Secrets belong only on the backend.
# Owner-supplied contact details; the footer and help links hide them until set.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Error reporting (web + api). Leave empty locally.
NEXT_PUBLIC_SENTRY_DSN=

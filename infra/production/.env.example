# Copy to .env next to compose.yml on the server (chmod 600). Never commit it or upload it to Hostinger.
# Database password: printed once by "server add-db valleyride".
DB_PASSWORD=REPLACE_WITH_PASSWORD_FROM_ADD_DB
# openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_HEX
CORS_ORIGINS=https://valleyride.in,https://www.valleyride.in

# Razorpay (Dashboard → Account & Settings → API keys; the webhook secret is the one you type when adding the webhook).
# Only the public key ID ever reaches the browser or app, at runtime.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS login codes (MSG91 with a DLT-approved OTP template). Nobody can log in until these are set.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Staff alerts and outgoing mail; optional.
SMTP_URL=
MAIL_FROM=Valley Ride <no-reply@valleyride.in>
OPS_EMAIL=

# Uploaded files stay on the server (the "uploads" volume), archived daily to ./backups, kept this many days.
BACKUP_KEEP_DAYS=14

CAPITAL_PORTAL_ENABLED=false
SENTRY_DSN=

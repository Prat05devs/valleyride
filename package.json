{
  "name": "valley-ride",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:hostinger": "tsc -p packages/shared/tsconfig.json && node apps/web/node_modules/next/dist/bin/next build apps/web && node infra/hostinger/prepare.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @valleyride/api db:migrate",
    "db:seed": "pnpm --filter @valleyride/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
